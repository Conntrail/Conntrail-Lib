# Copy this file to testing/.env and fill in your keys.
# testing/.env is gitignored — never commit real keys.

# Required: at least one LLM provider key
# Priority order: GROQ → ANTHROPIC → OPENAI
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: for ReAct agent web search tool
TAVILY_API_KEY=

# Optional: for LangSmith exporter (Phase 7)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contrail
